"""
proj-publisher — 主窗口 UI (Phase 1)

基于 ui-code.txt / ui-design.txt / ui-setting.txt 搭建完整界面。
包含：APP_STYLE、MainWindow 类、参数收集方法、占位槽函数。
"""

from __future__ import annotations

import sys
from PySide6.QtCore import Qt
from PySide6.QtGui import QFont, QGuiApplication
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QHBoxLayout, QVBoxLayout,
    QSplitter, QGroupBox, QLabel, QPushButton, QRadioButton,
    QButtonGroup, QLineEdit, QTextEdit, QFileDialog,
    QComboBox, QSpinBox, QCheckBox, QStatusBar, QFrame,
)

# ---------------------------------------------------------------------------
# 中文显示标签 ↔ 英文值映射表（供 Radio/Combo 读写使用）
# ---------------------------------------------------------------------------

STYLE_LABELS = ["新闻稿", "报道稿", "科普稿", "规范稿"]
SCENE_LABELS = ["对外发布", "内部汇报", "学习材料", "政策参考"]
AUDIENCE_LABELS = ["普通公众", "行业同行", "市场消费", "专业人员", "政策人员"]
LENGTH_STRATEGY_LABELS = ["压缩优先", "平衡", "扩写优先"]
LANGUAGE_LABELS = ["中文", "英文"]
TONE_LABELS = ["正式", "中性", "通俗", "生动", "文学化", "幽默"]
STRUCTURE_MODE_LABELS = ["保留原有结构", "优化结构", "重新组织结构"]

# ---------------------------------------------------------------------------
# APP_STYLE — 全局样式表
# ---------------------------------------------------------------------------
APP_STYLE = """
QWidget {
    background: #F7F9FC;
    color: #1F2937;
    font-family: 'Noto Sans';
    font-size: 9pt;
}

QGroupBox {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 8px;
    margin-top: 8px;
    padding: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #EAF2FF;
    min-height: 30px;
}

QTextEdit {
    min-height: auto;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #4C78A8;
}

QPushButton {
    background: #FFFFFF;
    border: 1px solid #DDE3EA;
    border-radius: 6px;
    padding: 6px 12px;
    min-height: 30px;
}

QPushButton:hover {
    background: #EEF4FB;
}

QPushButton#primaryButton {
    background: #4C78A8;
    color: white;
    border: none;
}

QPushButton#primaryButton:hover {
    background: #3F6792;
}

QRadioButton {
    spacing: 6px;
}

QScrollBar:vertical {
    width: 10px;
    background: #F7F9FC;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #C9D4E3;
    min-height: 24px;
    border-radius: 5px;
}

QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #DDE3EA;
}
"""


class MainWindow(QMainWindow):
    """文章改写工具主窗口。"""

    def __init__(self):
        super().__init__()

        self.setWindowTitle("文章改写工具")
        self.resize(1280, 720)
        self.setMinimumSize(960, 540)
        self.setFont(QFont("Noto Sans", 9))

        central = QWidget()
        self.setCentralWidget(central)

        root_layout = QVBoxLayout(central)
        root_layout.setContentsMargins(12, 12, 12, 12)
        root_layout.setSpacing(8)

        top_bar = self._build_top_bar()
        root_layout.addWidget(top_bar)

        splitter = QSplitter(Qt.Horizontal)
        splitter.setHandleWidth(8)

        left_panel = self._build_left_panel()
        right_panel = self._build_right_panel()

        splitter.addWidget(left_panel)
        splitter.addWidget(right_panel)
        splitter.setStretchFactor(0, 0)
        splitter.setStretchFactor(1, 1)
        splitter.setSizes([360, 920])

        root_layout.addWidget(splitter)

        self.setStatusBar(QStatusBar())
        self._status = self.statusBar()
        self.statusBar().showMessage("就绪")

    # -----------------------------------------------------------------------
    # T1.2 — 顶部操作栏
    # -----------------------------------------------------------------------

    def _build_top_bar(self):
        frame = QFrame()
        frame.setObjectName("topBar")
        layout = QHBoxLayout(frame)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(8)

        self.btn_new = QPushButton("新建")
        self.btn_clear = QPushButton("清空")
        layout.addWidget(self.btn_new)
        layout.addWidget(self.btn_clear)

        layout.addStretch(1)

        self.btn_start = QPushButton("开始写作")
        self.btn_start.setObjectName("primaryButton")
        layout.addWidget(self.btn_start)

        layout.addStretch(1)

        self.btn_save = QPushButton("保存")
        layout.addWidget(self.btn_save)

        fmt_group = QButtonGroup()
        self.rb_txt = QRadioButton("TXT")
        self.rb_txt.setChecked(True)
        self.rb_docx = QRadioButton("DOCX")
        fmt_group.addButton(self.rb_txt)
        fmt_group.addButton(self.rb_docx)
        layout.addWidget(self.rb_txt)
        layout.addWidget(self.rb_docx)

        self.btn_new.clicked.connect(self.new_project)
        self.btn_clear.clicked.connect(self.clear_all)
        self.btn_start.clicked.connect(self.start_writing)
        self.btn_save.clicked.connect(self.save_output)

        return frame

    # -----------------------------------------------------------------------
    # T1.3 — 左面板（输入源 + 参数 G1~G5）
    # -----------------------------------------------------------------------

    def _build_left_panel(self):
        scroll = QFrame()
        scroll.setFixedWidth(420)
        layout = QVBoxLayout(scroll)
        layout.setContentsMargins(0, 0, 0, 0)

        self._build_input_section(layout)
        self._build_param_group_g1(layout)
        self._build_param_group_g2(layout)
        self._build_param_group_g3(layout)
        self._build_param_group_g4(layout)
        self._build_param_group_g5(layout)

        return scroll

    # -----------------------------------------------------------------------
    # T1.4 — 左侧输入源区域
    # -----------------------------------------------------------------------

    def _build_input_section(self, layout: QVBoxLayout):
        gb = QGroupBox("输入来源")
        gl = QVBoxLayout(gb)
        gl.setSpacing(8)

        radio_layout = QHBoxLayout()
        self.rb_url = QRadioButton("网页链接")
        self.rb_url.setChecked(True)
        self.rb_text = QRadioButton("粘贴全文")
        self.rb_pdf = QRadioButton("上传 PDF")
        input_group = QButtonGroup()
        input_group.addButton(self.rb_url)
        input_group.addButton(self.rb_text)
        input_group.addButton(self.rb_pdf)
        radio_layout.addWidget(self.rb_url)
        radio_layout.addWidget(self.rb_text)
        radio_layout.addWidget(self.rb_pdf)
        gl.addLayout(radio_layout)

        self.url_row = QWidget()
        url_layout = QHBoxLayout(self.url_row)
        url_layout.setContentsMargins(0, 0, 0, 0)
        url_layout.setSpacing(8)
        self.url_edit = QLineEdit()
        self.url_edit.setPlaceholderText("https://...")
        btn_load_url = QPushButton("加载")
        url_layout.addWidget(self.url_edit)
        url_layout.addWidget(btn_load_url)

        self.text_input = QTextEdit()
        self.text_input.setPlaceholderText("在此粘贴全文…")
        self.text_input.setMaximumHeight(180)

        self.pdf_row = QWidget()
        pdf_layout = QHBoxLayout(self.pdf_row)
        pdf_layout.setContentsMargins(0, 0, 0, 0)
        pdf_layout.setSpacing(8)
        self.pdf_path = QLineEdit()
        self.pdf_path.setPlaceholderText("选择 PDF 文件…")
        self.pdf_path.setReadOnly(True)
        btn_open_pdf = QPushButton("打开 PDF")
        self.cb_pdf_ocr = QCheckBox("OCR 识别")
        pdf_layout.addWidget(self.pdf_path)
        pdf_layout.addWidget(btn_open_pdf)
        pdf_layout.addWidget(self.cb_pdf_ocr)

        gl.addWidget(self.url_row)
        gl.addWidget(self.text_input)
        gl.addWidget(self.pdf_row)

        layout.addWidget(gb)

        self.rb_url.toggled.connect(self.update_input_mode)
        self.rb_text.toggled.connect(self.update_input_mode)
        self.rb_pdf.toggled.connect(self.update_input_mode)
        btn_open_pdf.clicked.connect(self.choose_pdf)
        self.update_input_mode()

    # -----------------------------------------------------------------------
    # T1.5-G1 — 左侧内容参数区：文体与用途
    # -----------------------------------------------------------------------

    def _build_param_group_g1(self, layout: QVBoxLayout):
        """G1：文体与用途"""
        gb = QGroupBox("文体与用途")
        gl = QVBoxLayout(gb)
        gl.setSpacing(8)

        lbl = QLabel("改写目标")
        lbl.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl)
        style_row = QHBoxLayout()
        self.style_group = QButtonGroup()
        for label in STYLE_LABELS:
            rb = QRadioButton(label)
            self.style_group.addButton(rb)
            style_row.addWidget(rb)
        self.style_radios = [self.style_group.buttons()[i] for i in range(4)]
        self.style_radios[0].setChecked(True)
        gl.addLayout(style_row)
        hint = QLabel("决定输出文体")
        hint.setStyleSheet("color: #9CA3AF; font-size: 9pt; margin-top: -2px;")
        gl.addWidget(hint)

        lbl2 = QLabel("使用场景")
        lbl2.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl2)
        scene_row = QHBoxLayout()
        self.scene_group = QButtonGroup()
        for label in SCENE_LABELS:
            rb = QRadioButton(label)
            self.scene_group.addButton(rb)
            scene_row.addWidget(rb)
        self.scene_radios = [self.scene_group.buttons()[i] for i in range(4)]
        self.scene_radios[0].setChecked(True)
        gl.addLayout(scene_row)
        hint2 = QLabel("决定表达目的")
        hint2.setStyleSheet("color: #9CA3AF; font-size: 9pt; margin-top: -2px;")
        gl.addWidget(hint2)

        lbl3 = QLabel("目标受众")
        lbl3.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl3)
        self.audience_combo = QComboBox()
        self.audience_combo.addItems(AUDIENCE_LABELS)
        self.audience_combo.setCurrentIndex(0)
        gl.addWidget(self.audience_combo)
        hint3 = QLabel("决定语言深浅和信息密度")
        hint3.setStyleSheet("color: #9CA3AF; font-size: 9pt; margin-top: -2px;")
        gl.addWidget(hint3)

        layout.addWidget(gb)

    # -----------------------------------------------------------------------
    # T1.5-G2 — 左侧内容参数区：篇幅与字数
    # -----------------------------------------------------------------------

    def _build_param_group_g2(self, layout: QVBoxLayout):
        """G2：篇幅与字数"""
        gb = QGroupBox("篇幅与字数")
        gl = QVBoxLayout(gb)
        gl.setSpacing(8)

        lbl = QLabel("长度策略")
        lbl.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl)
        ls_row = QHBoxLayout()
        self.length_group = QButtonGroup()
        for label in LENGTH_STRATEGY_LABELS:
            rb = QRadioButton(label)
            self.length_group.addButton(rb)
            ls_row.addWidget(rb)
        self.length_radios = [self.length_group.buttons()[i] for i in range(3)]
        self.length_radios[1].setChecked(True)  # default=平衡
        gl.addLayout(ls_row)

        lbl2 = QLabel("目标字数")
        lbl2.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl2)
        words_row = QHBoxLayout()
        self.target_words = QSpinBox()
        self.target_words.setRange(100, 5000)
        self.target_words.setValue(800)
        words_row.addWidget(self.target_words)
        hint2 = QLabel("允许 ±20% 浮动")
        hint2.setStyleSheet("color: #9CA3AF; font-size: 9pt; margin-top: -2px;")
        words_row.addWidget(hint2)
        gl.addLayout(words_row)

        layout.addWidget(gb)

    # -----------------------------------------------------------------------
    # T1.5-G3 — 左侧内容参数区：语言与语气
    # -----------------------------------------------------------------------

    def _build_param_group_g3(self, layout: QVBoxLayout):
        """G3：语言与语气"""
        gb = QGroupBox("语言与语气")
        gl = QVBoxLayout(gb)
        gl.setSpacing(8)

        lbl = QLabel("输出语言")
        lbl.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl)
        self.language_combo = QComboBox()
        self.language_combo.addItems(LANGUAGE_LABELS)
        self.language_combo.setCurrentIndex(0)
        gl.addWidget(self.language_combo)

        lbl2 = QLabel("语气风格")
        lbl2.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl2)
        tone_row = QHBoxLayout()
        self.tone_group = QButtonGroup()
        for label in TONE_LABELS:
            rb = QRadioButton(label)
            self.tone_group.addButton(rb)
            tone_row.addWidget(rb)
        self.tone_radios = [self.tone_group.buttons()[i] for i in range(6)]
        self.tone_radios[0].setChecked(True)
        gl.addLayout(tone_row)

        layout.addWidget(gb)

    # -----------------------------------------------------------------------
    # T1.5-G4 — 左侧内容参数区：结构与格式
    # -----------------------------------------------------------------------

    def _build_param_group_g4(self, layout: QVBoxLayout):
        """G4：结构与格式"""
        gb = QGroupBox("结构与格式")
        gl = QVBoxLayout(gb)
        gl.setSpacing(8)

        lbl = QLabel("篇章结构模式")
        lbl.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl)
        sm_row = QHBoxLayout()
        self.struct_group = QButtonGroup()
        for label in STRUCTURE_MODE_LABELS:
            rb = QRadioButton(label)
            self.struct_group.addButton(rb)
            sm_row.addWidget(rb)
        self.struct_radios = [self.struct_group.buttons()[i] for i in range(3)]
        self.struct_radios[0].setChecked(True)  # default=保留原有结构
        gl.addLayout(sm_row)

        lbl2 = QLabel("格式要求")
        lbl2.setStyleSheet("font-weight: 600;")
        gl.addWidget(lbl2)
        fmt_row = QHBoxLayout()
        self.cb_title = QCheckBox("添加文章标题")
        self.cb_outline = QCheckBox("显示大纲结构")
        self.cb_paras = QCheckBox("段落分段优化")
        self.cb_bullet = QCheckBox("要点列表化")
        for cb in (self.cb_title, self.cb_outline, self.cb_paras, self.cb_bullet):
            fmt_row.addWidget(cb)
        gl.addLayout(fmt_row)

        layout.addWidget(gb)

    # -----------------------------------------------------------------------
    # T1.5-G5 — 左侧内容参数区：高级选项
    # -----------------------------------------------------------------------

    def _build_param_group_g5(self, layout: QVBoxLayout):
        """G5：高级选项"""
        gb = QGroupBox("高级选项")
        gl = QVBoxLayout(gb)
        gl.setSpacing(8)

        self.cb_keep_quotes = QCheckBox("保留原文引语")
        self.cb_preserve_names = QCheckBox("保留原文人名地名")
        gl.addWidget(self.cb_keep_quotes)
        gl.addWidget(self.cb_preserve_names)

        layout.addWidget(gb)

    # -----------------------------------------------------------------------
    # T2 — 右侧输出区（含标签页、导出/清空按钮）
    # -----------------------------------------------------------------------

    def _build_right_panel(self) -> QWidget:
        """构建右侧输出面板。"""
        container = QWidget()
        root_layout = QVBoxLayout(container)
        root_layout.setContentsMargins(0, 0, 0, 0)
        root_layout.setSpacing(8)

        # --- 上方操作栏 ---
        top_row = QHBoxLayout()
        btn_clear_out = QPushButton("清空输出")
        btn_export = QPushButton("导出结果")
        btn_export.setObjectName("primaryButton")
        btn_export.setFixedWidth(100)
        top_row.addStretch()
        top_row.addWidget(btn_clear_out)
        top_row.addWidget(btn_export)
        root_layout.addLayout(top_row)

        # --- 标签页 ---
        from PySide6.QtWidgets import QTabWidget
        self.tabs = QTabWidget()
        self.tabs.setTabsClosable(False)

        # Tab 1: 结果预览
        self.result_view = QTextEdit()
        self.result_view.setReadOnly(True)
        self.result_view.setPlaceholderText("改写结果将在此显示…")
        font = QFont("Noto Sans", 9)
        self.result_view.setFont(font)
        self.tabs.addTab(self.result_view, "结果预览")

        # Tab 2: 原文/结果对照
        diff_widget = QWidget()
        diff_layout = QVBoxLayout(diff_widget)
        diff_layout.setSpacing(8)
        left_splitter = QSplitter(Qt.Horizontal)
        self.orig_view = QTextEdit()
        self.orig_view.setReadOnly(True)
        self.orig_view.setPlaceholderText("原文…")
        font2 = QFont("Noto Sans", 9)
        self.orig_view.setFont(font2)
        self.gen_view = QTextEdit()
        self.gen_view.setReadOnly(True)
        self.gen_view.setPlaceholderText("生成结果…")
        self.gen_view.setFont(font2)
        left_splitter.addWidget(self.orig_view)
        left_splitter.addWidget(self.gen_view)
        left_splitter.setStretchFactor(0, 1)
        left_splitter.setStretchFactor(1, 1)
        diff_layout.addWidget(QLabel("原文 / 改写对照"))
        diff_layout.addWidget(left_splitter, stretch=1)
        self.tabs.addTab(diff_widget, "对照视图")

        root_layout.addWidget(self.tabs, stretch=1)

        # --- 下方辅助栏 ---
        bot_row = QHBoxLayout()
        btn_copy = QPushButton("复制结果")
        btn_save_local = QPushButton("本地保存")
        bot_row.addStretch()
        bot_row.addWidget(btn_copy)
        bot_row.addWidget(btn_save_local)
        root_layout.addLayout(bot_row)

        # 连线（占位）
        btn_clear_out.clicked.connect(self.clear_right_output)
        btn_export.clicked.connect(self.save_output)
        btn_copy.clicked.connect(lambda: QApplication.clipboard().setText(
            self.result_view.toPlainText()))
        btn_save_local.clicked.connect(self.save_output)

        return container

    # -----------------------------------------------------------------------
    # 输入模式切换 / 工具方法
    # -----------------------------------------------------------------------

    def update_input_mode(self):
        """根据当前选中的 RadioButton 启用/禁用对应的输入控件。"""
        mode = "text"
        if self.rb_url.isChecked():
            mode = "url"
        elif self.rb_pdf.isChecked():
            mode = "pdf"

        self.url_row.setEnabled(mode == "url")
        self.text_input.setEnabled(mode == "text")
        self.pdf_row.setEnabled(mode == "pdf")

    def choose_pdf(self):
        """弹出文件对话框选择 PDF。"""
        path, _ = QFileDialog.getOpenFileName(
            self, "选择 PDF", "", "*.pdf  (*.pdf)")
        if path:
            self.pdf_path.setText(path)

    # -----------------------------------------------------------------------
    # 顶部按钮槽函数（Phase-1 占位）
    # -----------------------------------------------------------------------

    def new_project(self):
        """新建项目：清空左右两侧。"""
        self.clear_all()

    def open_file(self):
        """打开本地文件到左侧输入区。"""
        path, _ = QFileDialog.getOpenFileName(
            self, "打开文件", "",
            "所有支持格式 (*.pdf *.docx *.txt);;PDF 文件 (*.pdf);;"
            "Word 文档 (*.docx);;文本文件 (*.txt)")
        if path:
            self._status.showMessage(f"已选择: {path}")

    def clear_all(self):
        """清空全部区域。"""
        self.clear_left_input()
        self.clear_right_output()
        if hasattr(self, "style_radios") and self.style_radios[0]:
            self.style_radios[0].setChecked(True)

    def start_writing(self):
        """开始改写。"""
        params = self.collect_parameters()
        text = self._get_input_text()
        if not text.strip():
            self._status.showMessage("请先输入或加载原文。")
            return

        self._status.showMessage("正在改写…")
        self.result_view.setPlainText("[改写结果将在此显示 — Phase 2]")
        self._status.showMessage("完成。", 3000)

    def save_output(self):
        """保存输出到本地。"""
        text = self.result_view.toPlainText()
        if not text.strip():
            self._status.showMessage("没有可保存的内容。")
            return
        path, _ = QFileDialog.getSaveFileName(
            self, "保存改写结果", "",
            "文本文件 (*.txt);;Word 文档 (*.docx)")
        if path:
            try:
                with open(path, "w", encoding="utf-8") as f:
                    f.write(text)
                self._status.showMessage(f"已保存到 {path}", 3000)
            except OSError as e:
                self._status.showMessage(f"保存失败: {e}")

    # -----------------------------------------------------------------------
    # 清除 / 读取辅助方法
    # -----------------------------------------------------------------------

    def clear_left_input(self):
        self.url_edit.clear()
        self.text_input.clear()
        self.pdf_path.clear()
        self.rb_text.setChecked(True)
        self.update_input_mode()

    def clear_right_output(self):
        self.result_view.clear()
        self.orig_view.clear()
        self.gen_view.clear()

    def _get_input_text(self) -> str:
        """从当前选中的输入模式获取文本。"""
        if self.rb_url.isChecked():
            return self.url_edit.text()
        if self.rb_pdf.isChecked():
            return f"[PDF]: {self.pdf_path.text()}"
        return self.text_input.toPlainText()

    # -----------------------------------------------------------------------
    # T1.7 — 参数收集方法（供 Phase-2 Prompt 拼接使用）
    # -----------------------------------------------------------------------

    def collect_parameters(self) -> dict:
        """收集左侧所有用户配置，返回结构化字典。"""
        style = (self.style_group.checkedButton().text()
                 if self.style_group.checkedButton() else STYLE_LABELS[0])
        scene = (self.scene_group.checkedButton().text()
                 if self.scene_group.checkedButton() else SCENE_LABELS[0])
        audience = self.audience_combo.currentText()
        length = (self.length_group.checkedButton().text()
                  if self.length_group.checkedButton() else LENGTH_STRATEGY_LABELS[1])
        words = self.target_words.value()
        language = self.language_combo.currentText()
        tone = (self.tone_group.checkedButton().text()
                if self.tone_group.checkedButton() else TONE_LABELS[0])
        structure = (self.struct_group.checkedButton().text()
                     if self.struct_group.checkedButton() else STRUCTURE_MODE_LABELS[0])

        return {
            "style": style,
            "scene": scene,
            "audience": audience,
            "length_strategy": length,
            "target_words": words,
            "language": language,
            "tone": tone,
            "structure_mode": structure,
            "add_title": self.cb_title.isChecked(),
            "show_outline": self.cb_outline.isChecked(),
            "paragraph_optimize": self.cb_paras.isChecked(),
            "bullet_points": self.cb_bullet.isChecked(),
            "keep_quotes": self.cb_keep_quotes.isChecked(),
            "preserve_names": self.cb_preserve_names.isChecked(),
        }
    # -----------------------------------------------------------------------
    # T1.9 — 窗口居中
    # -----------------------------------------------------------------------

    def _center_on_screen(self):
        """将窗口居中显示在屏幕中间。"""
        screen = QApplication.primaryScreen().geometry()
        geo = self.frameGeometry()
        center_point = screen.center()
        geo.moveCenter(center_point)
        self.move(geo.topLeft())


# ---------------------------------------------------------------------------
# 入口点
# ---------------------------------------------------------------------------

def main() -> None:
    app = QApplication(sys.argv)
    # HiDPI 支持：让样式表中的 px 值跟随系统 DPI 缩放（如 200%）
    QGuiApplication.setHighDpiScaleFactorRoundingPolicy(
        Qt.HighDpiScaleFactorRoundingPolicy.PassThrough
    )
    app.setStyle("Fusion")
    app.setStyleSheet(APP_STYLE)
    w = MainWindow()
    w._center_on_screen()
    w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
